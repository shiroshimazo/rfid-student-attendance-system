# Browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this key with NEXT_PUBLIC and never send it to ESP32.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Enable only after configuring the Teams/Enterprise Password Verification hook.
SUPABASE_PASSWORD_VERIFICATION_HOOK_ENABLED=false

# Best-effort Next.js login limiter. Use a long random server-only secret.
AUTH_RATE_LIMIT_SECRET=replace_with_at_least_32_random_bytes
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_IP_MAX_ATTEMPTS=20
AUTH_ACCOUNT_CAPTCHA_AFTER=3
AUTH_IP_CAPTCHA_AFTER=10

# Cloudflare Turnstile. Site key is browser-safe; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
