# Browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this key with NEXT_PUBLIC and never send it to ESP32.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Enable only after configuring the Teams/Enterprise Password Verification hook.
SUPABASE_PASSWORD_VERIFICATION_HOOK_ENABLED=false

# Best-effort Next.js login limiter. Use a long random server-only secret.
AUTH_RATE_LIMIT_SECRET=replace_with_at_least_32_random_bytes
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_IP_MAX_ATTEMPTS=20
AUTH_ACCOUNT_CAPTCHA_AFTER=3
AUTH_IP_CAPTCHA_AFTER=10

# Best-effort password-recovery limiter. Supabase also applies project-level
# email-send limits. All values are server-only.
RECOVERY_REQUEST_WINDOW_SECONDS=3600
RECOVERY_REQUEST_COOLDOWN_SECONDS=60
RECOVERY_ACCOUNT_MAX_REQUESTS=5
RECOVERY_IP_MAX_REQUESTS=20
RECOVERY_ACCOUNT_CAPTCHA_AFTER=2
RECOVERY_IP_CAPTCHA_AFTER=10
RECOVERY_VERIFY_WINDOW_SECONDS=900
RECOVERY_ACCOUNT_MAX_VERIFY_FAILURES=6
RECOVERY_IP_MAX_VERIFY_FAILURES=30
RECOVERY_VERIFY_CAPTCHA_AFTER=3
RECOVERY_IP_VERIFY_CAPTCHA_AFTER=15

# Cloudflare Turnstile production credentials. Local development automatically
# uses Cloudflare's official always-pass test pair; never deploy that test pair.
# Site key is browser-safe; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
